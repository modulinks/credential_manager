<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Groups (must be defined before being referenced in rules) -->
        <record id="group_credential_manager" model="res.groups">
            <field name="name">Credential Manager</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="comment">Users can manage all credentials</field>
        </record>

        <record id="group_consultants" model="res.groups">
            <field name="name">Consultants</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="comment">Consultants can view specific credentials based on collection access</field>
        </record>

        <record id="group_dev" model="res.groups">
            <field name="name">Developers</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="comment">Developers can access SSH credentials based on collection access</field>
            <field name="users" eval="[(4, ref('base.user_root'))]"/>
        </record>
    </data>

    <!-- Access Rules for Credentials -->
    
    <!-- Full Access for Administrators and Credential Managers -->
    <record id="rule_credential_manager_admin" model="ir.rule">
        <field name="name">Full Access for Administrators</field>
        <field name="model_id" ref="model_credential_manager"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system')), (4, ref('credential_manager.group_credential_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Access to Credentials based on Collection for Consultants and Developers -->
    <record id="rule_credential_collection_based" model="ir.rule">
        <field name="name">Access to Credentials by Collection</field>
        <field name="model_id" ref="model_credential_manager"/>
        <field name="domain_force">[('collection_id.group_ids', 'in', user.groups_id.ids)]</field>
        <field name="groups" eval="[(4, ref('credential_manager.group_consultants')), (4, ref('credential_manager.group_dev'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Allow read access for all users (for view/copy functionality) -->
    <record id="rule_credential_view_copy_all_users" model="ir.rule">
        <field name="name">View/Copy Credentials for All Users</field>
        <field name="model_id" ref="model_credential_manager"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Access Rules for Collections -->
    
    <!-- Full Access to Collections for Administrators -->
    <record id="rule_credential_collection_admin" model="ir.rule">
        <field name="name">Full Access to Collections for Administrators</field>
        <field name="model_id" ref="model_credential_collection"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system')), (4, ref('credential_manager.group_credential_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Access to Collections by Groups -->
    <record id="rule_credential_collection_access" model="ir.rule">
        <field name="name">Access to Collections by Groups</field>
        <field name="model_id" ref="model_credential_collection"/>
        <field name="domain_force">[('group_ids', 'in', user.groups_id.ids)]</field>
        <field name="groups" eval="[(4, ref('credential_manager.group_consultants')), (4, ref('credential_manager.group_dev'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>