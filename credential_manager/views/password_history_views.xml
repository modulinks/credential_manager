<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Password History Wizard Form -->
    <record id="view_password_history_wizard_form" model="ir.ui.view">
        <field name="name">password.history.wizard.form</field>
        <field name="model">password.history.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <h2>Password History</h2>
                </header>
                <sheet>
                    <field name="credential_id" invisible="1"/>
                    <div class="o_form_sheet_bg">
                        <field name="history_ids" nolabel="1" widget="one2many" options="{'no_create': true, 'no_open': true}">
                            <tree create="false" edit="false" delete="false" decoration-info="True">
                                <field name="change_date" string="Date &amp; Time" width="180px"/>
                                <field name="changed_by" string="Changed By" width="120px"/>
                                <field name="change_type" string="Password Type" width="140px"/>
                                <field name="passwords_display" string="Previous Passwords" width="400px"/>
                            </tree>
                        </field>
                    </div>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Password History Wizard -->
    <record id="action_password_history_wizard" model="ir.actions.act_window">
        <field name="name">Password History</field>
        <field name="res_model">password.history.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'large'}</field>
    </record>
</odoo>