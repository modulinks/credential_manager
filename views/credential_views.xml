<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Tree de Credential -->
    <record id="view_credential_tree" model="ir.ui.view">
        <field name="name">credential.manager.tree</field>
        <field name="model">credential.manager</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="collection_id"/>
                <field name="user"/>
                <field name="password"/>
                <field name="ssh_user" groups="base.group_system,credential_manager.group_dev"/>
                <field name="ssh_password" groups="base.group_system,credential_manager.group_dev"/>
                <field name="ssh_root_user" groups="base.group_system,credential_manager.group_dev"/>
                <field name="ssh_root_password" groups="base.group_system,credential_manager.group_dev"/>
                <field name="ip_address" groups="base.group_system,credential_manager.group_dev"/>
                <field name="dns" groups="base.group_system,credential_manager.group_dev"/>
                <field name="port" groups="base.group_system,credential_manager.group_dev"/>
                <field name="current_2fa_token" groups="credential_manager.group_credential_manager,base.group_system"/>
            </tree>
        </field>
    </record>

    <!-- Vista Formulario de Credential -->
    <record id="view_credential_form" model="ir.ui.view">
        <field name="name">credential.manager.form</field>
        <field name="model">credential.manager</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Item Details">
                        <field name="name" required="1" placeholder="Nombre del elemento"/>
                        <field name="collection_id" placeholder="Carpeta"/>
                    </group>
                    
                    <group string="Login Credentials">
                        <field name="user" placeholder="Usuario"/>
                        
                        <!-- Campo Password con botones -->
                        <label for="password" string="Contraseña"/>
                        <div class="o_row" style="display: flex; align-items: center;">
                            <field name="password" password="True" placeholder="Contraseña" nolabel="1" class="oe_inline" style="flex: 1; margin-right: 8px;" force_save="1"/>
                            <div style="display: flex; gap: 2px;" groups="credential_manager.group_credential_manager,credential_manager.group_consultants,credential_manager.group_dev,base.group_system">
                                <div class="fa fa-eye" style="cursor: pointer; padding: 8px 10px; display: inline-block; color: #6c757d; border: 1px solid #dee2e6; border-radius: 0.25rem; background-color: #f8f9fa;" 
                                     title="Mostrar/Ocultar contraseña"
                                     onclick="
                                     (function(btn){
                                         var input = btn.parentNode.parentNode.querySelector('input');
                                         if(input){
                                             input.disabled = false;
                                             if(input.type === 'password'){
                                                 input.type = 'text';
                                                 btn.className = 'fa fa-eye-slash';
                                             } else {
                                                 input.type = 'password';
                                                 btn.className = 'fa fa-eye';
                                             }
                                         }
                                     })(this);"/>
                                <div class="fa fa-copy" style="cursor: pointer; padding: 8px 10px; display: inline-block; color: #6c757d; border: 1px solid #dee2e6; border-radius: 0.25rem; background-color: #f8f9fa;" 
                                     title="Copiar contraseña"
                                     onclick="
                                     (function(btn){
                                         var input = btn.parentNode.parentNode.querySelector('input');
                                         if(input &amp;&amp; input.value){
                                             input.disabled = false;
                                             try {
                                                 if(navigator.clipboard){
                                                     navigator.clipboard.writeText(input.value).then(function(){
                                                         alert('Contraseña copiada al portapapeles');
                                                     }).catch(function(e){
                                                         console.log('Error copiando:', e);
                                                     });
                                                 } else {
                                                     input.select();
                                                     document.execCommand('copy');
                                                     alert('Contraseña copiada al portapapeles');
                                                 }
                                             } catch(e) {
                                                 console.log('Error copiando:', e);
                                             }
                                         }
                                     })(this);"/>
                            </div>
                        </div>

                        <field name="url_1" placeholder="URL 1"/>
                        <field name="url_2" placeholder="URL 2"/>
                        <field name="url_3" placeholder="URL 3"/>
                        <field name="url_4" placeholder="URL 4"/>
                        <field name="notes" widget="text" placeholder="Notas"/>
                    </group>

                    <!-- Nueva sección exclusiva para administradores -->
                    <group string="Autenticación 2FA" groups="credential_manager.group_credential_manager,base.group_system">
                        <field name="use_2fa" string="Habilitar 2FA"/>
                        <field name="secret_2fa" placeholder="Ingresa tu secreto (ej. Y3PG 4DGQ Y4ND 2D4P...)" attrs="{'invisible': [('use_2fa', '=', False)]}"/>
                        <field name="current_2fa_token" readonly="1" attrs="{'invisible': [('use_2fa', '=', False)]}"/>
                    </group>
                    
                    <group string="Detalles de SSH/Dev" groups="credential_manager.group_dev,credential_manager.group_credential_manager,base.group_system">
                        <field name="ssh_user" placeholder="Usuario SSH"/>
                        
                        <!-- Campo SSH Password con botones -->
                        <label for="ssh_password" string="Contraseña SSH"/>
                        <div class="o_row" style="display: flex; align-items: center;">
                            <field name="ssh_password" password="True" placeholder="Contraseña SSH" nolabel="1" class="oe_inline" style="flex: 1; margin-right: 8px;" force_save="1"/>
                            <div style="display: flex; gap: 2px;" groups="credential_manager.group_credential_manager,credential_manager.group_consultants,credential_manager.group_dev,base.group_system">
                                <div class="fa fa-eye" style="cursor: pointer; padding: 8px 10px; display: inline-block; color: #6c757d; border: 1px solid #dee2e6; border-radius: 0.25rem; background-color: #f8f9fa;" 
                                     title="Mostrar/Ocultar SSH"
                                     onclick="
                                     (function(btn){
                                         var input = btn.parentNode.parentNode.querySelector('input');
                                         if(input){
                                             input.disabled = false;
                                             if(input.type === 'password'){
                                                 input.type = 'text';
                                                 btn.className = 'fa fa-eye-slash';
                                             } else {
                                                 input.type = 'password';
                                                 btn.className = 'fa fa-eye';
                                             }
                                         }
                                     })(this);"/>
                                <div class="fa fa-copy" style="cursor: pointer; padding: 8px 10px; display: inline-block; color: #6c757d; border: 1px solid #dee2e6; border-radius: 0.25rem; background-color: #f8f9fa;" 
                                     title="Copiar SSH"
                                     onclick="
                                     (function(btn){
                                         var input = btn.parentNode.parentNode.querySelector('input');
                                         if(input &amp;&amp; input.value){
                                             input.disabled = false;
                                             try {
                                                 if(navigator.clipboard){
                                                     navigator.clipboard.writeText(input.value).then(function(){
                                                         alert('Contraseña copiada al portapapeles');
                                                     }).catch(function(e){
                                                         console.log('Error copiando:', e);
                                                     });
                                                 } else {
                                                     input.select();
                                                     document.execCommand('copy');
                                                     alert('Contraseña copiada al portapapeles');
                                                 }
                                             } catch(e) {
                                                 console.log('Error copiando:', e);
                                             }
                                         }
                                     })(this);"/>
                            </div>
                        </div>
                        
                        <field name="ip_address" placeholder="Ej. 192.168.1.1"/>
                        <field name="dns" placeholder="Ej. dns.example.com"/>
                        <field name="port" placeholder="Ej. 22"/>
                        <field name="private_key" widget="text" placeholder="Ingresa la clave privada"/>
                    </group>
                    
                    <group string="ACCESOS SSH Root" groups="credential_manager.group_credential_manager,base.group_system">
                        <field name="ssh_root_user" placeholder="Usuario SSH Root"/>
                        
                        <!-- Campo SSH Root Password con botones -->
                        <label for="ssh_root_password" string="Contraseña SSH Root"/>
                        <div class="o_row" style="display: flex; align-items: center;">
                            <field name="ssh_root_password" password="True" placeholder="Contraseña SSH Root" nolabel="1" class="oe_inline" style="flex: 1; margin-right: 8px;" force_save="1"/>
                            <div style="display: flex; gap: 2px;" groups="credential_manager.group_credential_manager,base.group_system">
                                <div class="fa fa-eye" style="cursor: pointer; padding: 8px 10px; display: inline-block; color: #6c757d; border: 1px solid #dee2e6; border-radius: 0.25rem; background-color: #f8f9fa;" 
                                     title="Mostrar/Ocultar SSH Root"
                                     onclick="
                                     (function(btn){
                                         var input = btn.parentNode.parentNode.querySelector('input');
                                         if(input){
                                             input.disabled = false;
                                             if(input.type === 'password'){
                                                 input.type = 'text';
                                                 btn.className = 'fa fa-eye-slash';
                                             } else {
                                                 input.type = 'password';
                                                 btn.className = 'fa fa-eye';
                                             }
                                         }
                                     })(this);"/>
                                <div class="fa fa-copy" style="cursor: pointer; padding: 8px 10px; display: inline-block; color: #6c757d; border: 1px solid #dee2e6; border-radius: 0.25rem; background-color: #f8f9fa;" 
                                     title="Copiar SSH Root"
                                     onclick="
                                     (function(btn){
                                         var input = btn.parentNode.parentNode.querySelector('input');
                                         if(input &amp;&amp; input.value){
                                             input.disabled = false;
                                             try {
                                                 if(navigator.clipboard){
                                                     navigator.clipboard.writeText(input.value).then(function(){
                                                         alert('Contraseña copiada al portapapeles');
                                                     }).catch(function(e){
                                                         console.log('Error copiando:', e);
                                                     });
                                                 } else {
                                                     input.select();
                                                     document.execCommand('copy');
                                                     alert('Contraseña copiada al portapapeles');
                                                 }
                                             } catch(e) {
                                                 console.log('Error copiando:', e);
                                             }
                                         }
                                     })(this);"/>
                            </div>
                        </div>
                        
                        <field name="ssh_root_ip_address" placeholder="Ej. 192.168.1.1"/>
                        <field name="ssh_root_dns" placeholder="Ej. root.dns.example.com"/>
                        <field name="ssh_root_port" placeholder="Ej. 22"/>
                        <field name="ssh_root_private_key" widget="text" placeholder="Ingresa la clave privada SSH Root"/>
                    </group>

                    <!-- Campos personalizados comentados -->
                    <!--
                    <group string="Campos Personalizados" colspan="4">
                        <field name="custom_fields">
                            <tree editable="bottom" create="false" delete="false">
                                <field name="name" string="Nombre"/>
                                <field name="value" string="Valor"/>
                            </tree>
                        </field>
                    </group>
                    -->
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Wizard para agregar campos personalizados -->
    <record id="view_credential_custom_field_wizard" model="ir.ui.view">
        <field name="name">credential.custom.field.wizard.form</field>
        <field name="model">credential.custom.field.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" required="1"/>
                    <field name="value"/>
                    <field name="field_type" required="1"/>
                    <field name="linked_field" attrs="{'required': [('field_type', '=', 'linked')], 'invisible': [('field_type', '!=', 'linked')]}"/>
                </group>
                <footer>
                    <button name="action_save_custom_field" string="Guardar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard para validar acceso -->
    <record id="view_credential_access_wizard" model="ir.ui.view">
        <field name="name">credential.access.wizard.form</field>
        <field name="model">credential.access.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="credential_id" invisible="1"/>
                    <field name="code_2fa" placeholder="Código 2FA"/>
                </group>
                <footer>
                    <button name="verify_and_access" string="Verificar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Vista de lista para Colecciones -->
    <record id="view_collection_tree" model="ir.ui.view">
        <field name="name">credential.collection.tree</field>
        <field name="model">credential.collection</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Formulario para Colecciones -->
    <record id="view_collection_form" model="ir.ui.view">
        <field name="name">credential.collection.form</field>
        <field name="model">credential.collection</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" required="1" placeholder="Nombre de la colección"/>
                        <field name="group_ids" widget="many2many_tags" string="Grupos"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acciones -->
    <record id="action_credential_manager" model="ir.actions.act_window">
        <field name="name">Credenciales</field>
        <field name="res_model">credential.manager</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_collection_manager" model="ir.actions.act_window">
        <field name="name">Colecciones</field>
        <field name="res_model">credential.collection</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_credential_access_wizard" model="ir.actions.act_window">
        <field name="name">Verificar 2FA</field>
        <field name="res_model">credential.access.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>